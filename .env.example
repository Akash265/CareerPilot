NODE_ENV=development

# Fixed local single-user identity (DECISIONS.md D1/D2) — do not change unless
# you understand the RLS implications in packages/db/src/rls.ts
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# App runtime uses the least-privilege, non-superuser role (DECISIONS.md D12)
# so RLS policies are actually enforced, not silently bypassed.
DATABASE_URL=postgres://career_intel_app:career_intel_app@localhost:5432/career_intel
# Migrations need the superuser role (RLS-bypass is required for schema DDL).
# Never used by app runtime code — only by drizzle-kit generate/migrate.
MIGRATIONS_DATABASE_URL=postgres://career_intel:career_intel@localhost:5432/career_intel
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Real key required only once Phase 2+ makes actual LLM calls; a placeholder
# is fine for Phase 0/1 since no code path calls Anthropic yet.
ANTHROPIC_API_KEY=sk-ant-replace-me

# voyage | self-hosted — see DECISIONS.md D7
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=replace-me

# Fast/cheap-tier model for straightforward tasks like resume extraction —
# role-based selection, not a hardcoded version string (DECISIONS.md D7).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Research-tier model for Phase 7a company research (web search). Must support the
# web_search_20250305 tool — DECISIONS.md D70, D79.
ANTHROPIC_MODEL_RESEARCH=claude-sonnet-5
# Web searches allowed per company-research call (1-20). Bounds cost per company.
# COMPANY_RESEARCH_MAX_SEARCHES=5

# Determines profile_facts.embedding's vector dimension
# (packages/db/src/schema/profileFacts.ts, PROFILE_FACT_EMBEDDING_DIMENSIONS).
# If you change this, verify the new model's output dimension against
# Voyage's current docs and update that constant + regenerate the Task 2
# migration before applying it — pgvector requires a fixed dimension at
# column creation.
VOYAGE_EMBEDDING_MODEL=voyage-3.5

# Phase 4 job ingestion. Defaults are the public board APIs; override only to
# point the worker at a local fake ATS server (services/job-ingestion/e2e).
# GREENHOUSE_API_BASE=https://boards-api.greenhouse.io
# LEVER_API_BASE=https://api.lever.co
# Voyage embeddings endpoint (DECISIONS.md D183). Only the E2E suite changes it, to a local stand-in.
# VOYAGE_API_BASE=https://api.voyageai.com
# Minutes between scheduled fetches of each enabled board (minimum 5).
# INGEST_INTERVAL_MINUTES=360

# Phase 5 matching. Defaults are starting guesses (design doc §10), all overridable.
# How many top-ranked eligible jobs get an AI-generated explanation per run.
# MATCHING_EXPLAIN_TOP_N=25
# Years beyond a job's stated minimum experience that still counts as eligible.
# MATCHING_EXPERIENCE_GRACE_YEARS=1
# Freshness-score half-life in hours (job postings older than this decay toward zero).
# MATCHING_FRESHNESS_HALF_LIFE_HOURS=168
# Days before a stored AI explanation is regenerated even if nothing else changed.
# MATCHING_EXPLANATION_TTL_DAYS=7

# Phase 9: days after an application's terminal status before its generated documents are deleted. 0 disables.
# RETENTION_DAYS=30
# Phase 10a insights. Days without activity before an open application counts as "no response" / "no interview".
# OUTCOME_UNDECIDED_DAYS=30
# Minimum decided applications in a group before the Insights page shows a rate for it (at least 2).
# INSIGHTS_MIN_BUCKET=5
# Phase 10b personal response model. Decided applications (with match scores) needed before the model is tried
# (at least 10), and the minimum number with and without a response (at least 3).
# OUTCOME_MODEL_MIN_DECIDED=30
# OUTCOME_MODEL_MIN_PER_CLASS=8

# Phase 11a AI cost control. Monthly ceiling in USD on ESTIMATED AI spend (Anthropic + Voyage, from a built-in
# price table -- not your invoice). At the ceiling every new AI call is blocked until the next UTC month.
# 0 means no ceiling. Blank uses the default.
# AI_MONTHLY_BUDGET_USD=20
# Percent of the ceiling at which the app starts warning (1-100).
# AI_BUDGET_WARN_PERCENT=80
# Optional Langfuse export (metadata only: operation, model, tokens, cost, latency, outcome -- never prompt or
# response text). Set all three or none; Langfuse Cloud or self-hosted.
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Phase 11b. Minimum log level: debug | info | warn | error (default info).
# LOG_LEVEL=info
# How often each worker writes its heartbeat, in milliseconds (minimum 1000).
# HEARTBEAT_INTERVAL_MS=30000
# Milliseconds without a heartbeat before /status calls a worker "stale". Must be longer than HEARTBEAT_INTERVAL_MS
# (about 3x is a good margin); set both the same way for the web app and the workers.
# STATUS_STALE_AFTER_MS=90000

# --- Phase 11c: access & rate limits (DECISIONS.md D177, D178) ---
# Interface the web app listens on. 127.0.0.1 keeps it off the network; 0.0.0.0 opens it to your LAN, so set
# APP_ACCESS_TOKEN too (the app logs exposed_without_token at startup otherwise).
# APP_HOST=127.0.0.1
# Extra Host header values to accept besides localhost/127.0.0.1/[::1], comma-separated (e.g. pilot.lan,192.168.1.20:3000).
# ALLOWED_HOSTS=
# When set (at least 32 characters, e.g. `openssl rand -hex 32`), every page and API route needs it: enter it once
# on /unlock (sets a cookie), or send `Authorization: Bearer <token>`. Use TLS for anything beyond a trusted LAN.
# APP_ACCESS_TOKEN=
# Requests per minute for routes that call the AI, and for routes that start background work or uploads. 0 = no limit.
# RATE_LIMIT_AI_PER_MINUTE=10
# RATE_LIMIT_JOBS_PER_MINUTE=20

# Phase 8 browser autofill (services/browser-worker, run on the host, not in Docker).
# Override the Chrome binary the worker launches; omitted, it uses Playwright's "chrome" channel.
# BROWSER_EXECUTABLE_PATH=
# Headed (false) so you can see and use the window; true is for the worker's own tests only.
# BROWSER_HEADLESS=false
# Minutes an awaiting_user window stays open for you before the worker closes it (1-240).
# BROWSER_SESSION_TIMEOUT_MIN=30

# --- Phase 12: broad job discovery (DECISIONS.md D184-D188) ---
# Free API keys for the search providers that need one; without its key a provider cannot be switched on.
# Adzuna: https://developer.adzuna.com (both values). Countries searched: two-letter codes.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRIES=us,gb
# Jooble: https://jooble.org/api/about
# JOOBLE_API_KEY=
# USAJobs: https://developer.usajobs.gov (the key and the email you registered with).
# USAJOBS_API_KEY=
# USAJOBS_USER_AGENT=
# Search window and depth, discovery limits and politeness.
# DISCOVERY_MAX_DAYS_OLD=30
# DISCOVERY_MAX_PAGES=2
# DISCOVERY_MAX_SOURCES=300
# DISCOVERY_MAX_NEW_PER_RUN=25
# DISCOVERY_MIN_INTERVAL_MS=1000
# DISCOVERY_STALE_DAYS=14
# Phase 13a: one-click discovery. Sources that ran within FIND_JOBS_FRESH_MINUTES are reused; the run waits at most
# FIND_JOBS_MAX_WAIT_SECONDS for the rest (later ones re-rank automatically, debounced by MATCH_DEBOUNCE_SECONDS).
# FIND_JOBS_FRESH_MINUTES=360
# FIND_JOBS_MAX_WAIT_SECONDS=180
# FIND_JOBS_MATCH_WAIT_SECONDS=300
# MATCH_DEBOUNCE_SECONDS=120
# Employer names checked against the six ATS platforms per run, and the goal-driven web search (uses ANTHROPIC_MODEL_RESEARCH
# and the AI budget; at most once per goal change or per interval).
# DISCOVERY_PROBE_MAX_NAMES=30
# DISCOVERY_WEB_SEARCH=true
# DISCOVERY_WEB_SEARCH_INTERVAL_DAYS=7
# DISCOVERY_WEB_SEARCH_MAX_USES=5
# Phase 13b: after each matching run, required skills are checked for this many top eligible matches (one
# fast-model call per job not checked yet; cached by description). They are listed on /skills.
# SKILL_GAP_TOP_N=25
# Provider API bases (only tests and the E2E suite change these): ASHBY_API_BASE, WORKABLE_API_BASE,
# SMARTRECRUITERS_API_BASE, RECRUITEE_API_BASE (a template with {slug}), ADZUNA_API_BASE, JOOBLE_API_BASE,
# USAJOBS_API_BASE, THEMUSE_API_BASE, REMOTIVE_API_BASE, REMOTEOK_API_BASE, ARBEITNOW_API_BASE, HN_API_BASE.
# Phase 13c — tailored LaTeX resume. Start the compiler with:
#   docker compose -f infra/docker-compose.yml --env-file .env --profile latex up -d latex-compiler
# Generate the token with: openssl rand -hex 32   (at least 32 characters; the same value is given to the container)
# LATEX_COMPILER_URL=http://127.0.0.1:8090
# LATEX_COMPILER_TOKEN=
# RESUME_PAPER_SIZE=a4   # a4 | letter
