{
  "name": "ai-career-intelligence",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "bash scripts/start.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "retention:run": "pnpm --filter @ai-career/maintenance-worker retention:run",
    "e2e": "pnpm --filter @ai-career/e2e e2e"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
