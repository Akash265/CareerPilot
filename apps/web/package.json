{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'next dev -H \"${APP_HOST:-127.0.0.1}\"'",
    "build": "node -e \"require('fs').rmSync('.next/server/route-cache', { recursive: true, force: true })\" && NODE_ENV=production dotenv -e ../../.env -- next build",
    "start": "node -e \"require('fs').rmSync('.next/server/route-cache', { recursive: true, force: true })\" && NODE_ENV=production dotenv -e ../../.env -- sh -c 'next start -H \"${APP_HOST:-127.0.0.1}\"'",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@ai-career/ai": "workspace:*",
    "@ai-career/application-package": "workspace:*",
    "@ai-career/applications": "workspace:*",
    "@ai-career/browser": "workspace:*",
    "@ai-career/config": "workspace:*",
    "@ai-career/db": "workspace:*",
    "@ai-career/document-export": "workspace:*",
    "@ai-career/ingestion": "workspace:*",
    "@ai-career/insights": "workspace:*",
    "@ai-career/logging": "workspace:*",
    "@ai-career/matching": "workspace:*",
    "@ai-career/monitoring": "workspace:*",
    "@ai-career/resume-optimization": "workspace:*",
    "@ai-career/storage": "workspace:*",
    "@anthropic-ai/sdk": "^0.128.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.4.0",
    "next": "16.3.8",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^25.0.1",
    "postgres": "^3.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.0"
}
