{
  "name": "@ai-career/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:generate:custom": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=candidate_profile_rls",
    "db:generate:custom:career-goal-rls": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=career_goal_rls",
    "db:generate:custom:resume-optimization-rls": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=resume_optimization_rls",
    "db:generate:custom:application-package-rls": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=application_package_rls",
    "db:generate:custom:generated-documents-rls": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=generated_documents_rls",
    "db:generate:custom:cover-letter-interview-prep-rls": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=cover_letter_interview_prep_rls",
    "db:generate:custom:applications-rls": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=applications_rls",
    "db:generate:custom:automation-sessions-rls": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=automation_sessions_rls",
    "db:generate:custom:ai-calls-rls": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=ai_calls_rls",
    "db:generate:custom:search-runs-rls": "dotenv -e ../../.env -- drizzle-kit generate --custom --name=search_runs_rls",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate"
  },
  "dependencies": {
    "@ai-career/config": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "dotenv-cli": "^7.4.0",
    "vitest": "^2.1.0",
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
